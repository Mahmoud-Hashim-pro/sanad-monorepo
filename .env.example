# PostgreSQL Local Dev Configuration
POSTGRES_USER=sanad_user
POSTGRES_PASSWORD=sanad_local_dev_password
POSTGRES_DB=sanad_db
POSTGRES_PORT=5433
DATABASE_URL="postgresql://sanad_user:sanad_local_dev_password@localhost:5433/sanad_db?schema=public"

# NestJS Backend Configuration
PORT=4000
NODE_ENV=development
NATIONAL_ID_HMAC_PEPPER="replace-with-32-byte-secret-in-local-env"
NATIONAL_ID_ENCRYPTION_KEY="replace-with-32-byte-aes-gcm-key-in-local-env"

# Next.js Frontend Configuration
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_MODE="preview_mock"
