{
  "name": "sanad-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @sanad/database db:generate",
    "db:push": "pnpm --filter @sanad/database db:push",
    "db:migrate": "pnpm --filter @sanad/database db:migrate",
    "db:seed": "pnpm --filter @sanad/database db:seed"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
